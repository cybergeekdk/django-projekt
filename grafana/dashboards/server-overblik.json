      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "monitor-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT s.name AS server, c.name AS container, c.image, c.state, c.status, c.updated\nFROM core_container c JOIN core_server s ON s.id = c.server_id\nWHERE s.name IN ($server) ORDER BY 1, 2"
        }
