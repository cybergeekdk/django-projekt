{
  "uid": "server-overblik",
  "title": "Server-overblik",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "monitor"
  ],
  "templating": {
    "list": [
      {
        "name": "server",
        "label": "Server",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "monitor-pg"
        },
        "query": "SELECT name FROM core_server WHERE is_active ORDER BY 1",
        "definition": "SELECT name FROM core_server WHERE is_active ORDER BY 1",
        "multi": true,
        "includeAll": true,
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU (load / kerner, %)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "monitor-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "monitor-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT m.created AS time, s.name AS metric, m.cpu_percent AS value\nFROM core_metric m JOIN core_server s ON s.id = m.server_id\nWHERE s.name IN ($server) AND m.reachable AND $__timeFilter(m.created)\nORDER BY 1"
        }
      ]
    },
    {
